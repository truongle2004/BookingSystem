# Public application configuration
APP_ENV=local
HTTP_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
LOG_LEVEL=INFO

# PostgreSQL configuration
APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=bookingsystem
POSTGRES_USER=bookingsystem
POSTGRES_PASSWORD=bookingsystem
DATABASE_URL=jdbc:postgresql://localhost:5432/bookingsystem
DATABASE_USER=bookingsystem
DATABASE_PASSWORD=bookingsystem
DB_CONNECT_TIMEOUT=3s
DB_QUERY_TIMEOUT=5s
DB_POOL_MAX=10

# OpenTelemetry trace export.
OTEL_SERVICE_NAME=bookingsystem
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=0.1

# Clerk JWT configuration
CLERK_ISSUER_URI=https://<your-clerk-instance>.clerk.accounts.dev
# Optional when issuer metadata discovery is unavailable or must be overridden.
CLERK_JWK_SET_URI=
# Optional expected JWT audience.
CLERK_AUDIENCE=
# Optional comma-separated allow-list checked against the azp claim.
CLERK_AUTHORIZED_PARTIES=
# Allowed JWT clock skew.
CLERK_CLOCK_SKEW=30s

# Reserved for Milestone 2; currently unused.
# HOLD_DURATION=10m
